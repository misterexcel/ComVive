# Copy to .env for local development. Never commit real values (CLAUDE.md, rule 9).
PORT=3000
# Proxies in front of the API, counted from the right of X-Forwarded-For (ADR 0009, decision 7).
# 0 only locally and in CI; on Cloud Run 1 with the run.app URL, 2 behind the external load
# balancer (ADR-0009-S8). Never "true". With 2, the service ingress must be
# internal-and-cloud-load-balancing: a public run.app URL would let a client forge its IP.
TRUST_PROXY_HOPS=0
